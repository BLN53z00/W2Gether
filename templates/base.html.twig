<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}WorkTogether{% endblock %} | WorkTogether Data Solutions</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233b82f6'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% set route = app.request.attributes.get('_route') %}

<nav class="nav">
    <div class="nav-inner">
        <a class="nav-logo" href="{{ path('app_home') }}">
            <span class="nav-logo-mark"></span> WorkTogether
        </a>

        <div class="nav-links">
            <a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? 'active' : '' }}">Accueil</a>
            <a href="{{ path('app_offres') }}" class="{{ route == 'app_offres' ? 'active' : '' }}">Offres</a>

            {% if is_granted('ROLE_CLIENT') %}
                <a href="{{ path('espace_accueil') }}" class="{{ route == 'espace_accueil' ? 'active' : '' }}">Mon espace</a>
                <a href="{{ path('espace_unites') }}" class="{{ route in ['espace_unites', 'espace_unite_edit'] ? 'active' : '' }}">Mes unités</a>
                <a href="{{ path('espace_baies') }}" class="{{ route == 'espace_baies' ? 'active' : '' }}">Mes baies</a>
            {% endif %}
        </div>

        <div class="nav-user">
            {% if app.user %}
                <span>{{ app.user.prenom }} {{ app.user.nom }}</span>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}">Connexion</a>
                <a href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="footer">
    &copy; {{ 'now'|date('Y') }} WorkTogether Data Solutions
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>
