{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-dark: #0b1220;
            --bg-dark-2: #131c31;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --text: #0f172a;
            --muted: #64748b;
            --border: #cbd5e1;
        }

        body { margin: 0; }
        * { box-sizing: border-box; }

        .login-page {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            color: var(--text);
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.1fr 1fr;
        }

        /* ---------- Panneau gauche (marque) ---------- */
        .login-brand {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at 20% 20%, rgba(59, 130, 246, .35), transparent 45%),
                radial-gradient(circle at 80% 85%, rgba(14, 165, 233, .25), transparent 40%),
                linear-gradient(160deg, var(--bg-dark), var(--bg-dark-2));
            color: #e2e8f0;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .login-brand::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(
                0deg,
                rgba(255, 255, 255, .035) 0,
                rgba(255, 255, 255, .035) 1px,
                transparent 1px,
                transparent 18px
            );
            pointer-events: none;
        }

        .login-brand > * { position: relative; z-index: 1; }

        .login-logo {
            display: flex;
            align-items: center;
            gap: .75rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
        }

        .login-logo-mark {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--accent);
            display: grid;
            place-items: center;
            font-size: 1.15rem;
        }

        .login-pitch h2 { font-size: 2rem; line-height: 1.25; color: #fff; margin: 0 0 1rem; }
        .login-pitch p { color: #94a3b8; max-width: 30rem; line-height: 1.6; margin: 0; }

        .login-features { margin: 2rem 0 0; padding: 0; list-style: none; display: grid; gap: .85rem; }
        .login-features li { display: flex; align-items: center; gap: .75rem; color: #cbd5e1; }

        .login-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 4px rgba(34, 197, 94, .18);
            flex-shrink: 0;
        }

        .login-brand small { color: #64748b; }

        /* ---------- Panneau droit (formulaire) ---------- */
        .login-panel {
            background: #f8fafc;
            display: grid;
            place-items: center;
            padding: 2rem 1.25rem;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 2.25rem;
            box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        }

        .login-card h1 { font-size: 1.6rem; margin: 0 0 .35rem; }
        .login-subtitle { color: var(--muted); margin: 0 0 1.75rem; font-size: .95rem; }

        .login-alert {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: .75rem 1rem;
            margin-bottom: 1.25rem;
            font-size: .92rem;
        }

        .login-info {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: .75rem 1rem;
            margin-bottom: 1.25rem;
            font-size: .92rem;
        }

        .login-field { margin-bottom: 1.15rem; }

        .login-card label {
            display: block;
            font-size: .88rem;
            font-weight: 600;
            margin-bottom: .4rem;
        }

        .login-input-wrap { position: relative; }

        .login-card input[type="email"],
        .login-card input[type="password"],
        .login-card input[type="text"] {
            width: 100%;
            padding: .8rem 1rem;
            font-size: 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #fff;
            color: var(--text);
            transition: border-color .15s, box-shadow .15s;
        }

        .login-card input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, .18);
        }

        .login-toggle {
            position: absolute;
            right: .5rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--muted);
            font-size: .8rem;
            font-weight: 600;
            cursor: pointer;
            padding: .4rem .6rem;
            border-radius: 6px;
        }

        .login-toggle:hover { color: var(--accent); }

        .login-btn {
            width: 100%;
            padding: .85rem 1rem;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            background: var(--accent);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background .15s;
            margin-top: .5rem;
        }

        .login-btn:hover { background: var(--accent-hover); }

        .login-links {
            margin: 1.5rem 0 0;
            text-align: center;
            font-size: .92rem;
            color: var(--muted);
        }

        .login-links + .login-links { margin-top: .75rem; }
        .login-links a { color: var(--accent); font-weight: 600; text-decoration: none; }
        .login-links a:hover { text-decoration: underline; }

        /* ---------- Responsive ---------- */
        @media (max-width: 860px) {
            .login-page { grid-template-columns: 1fr; }
            .login-brand { padding: 1.75rem 1.5rem; gap: 1.5rem; }
            .login-pitch h2 { font-size: 1.5rem; }
            .login-features, .login-brand small { display: none; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-page">

        <aside class="login-brand">
            <a class="login-logo" href="{{ path('app_home') }}">
                <span class="login-logo-mark">🗄️</span>
                WorkTogether
            </a>

            <div class="login-pitch">
                <h2>Vos équipements, hébergés en toute sécurité.</h2>
                <p>
                    Accédez à votre espace client pour suivre vos baies, consulter l’état de vos unités
                    et gérer vos équipements dans nos datacenters.
                </p>

                <ul class="login-features">
                    <li><span class="login-dot"></span> Connectivité ultrarapide</li>
                    <li><span class="login-dot"></span> Redondance électrique</li>
                    <li><span class="login-dot"></span> Sécurité physique et électronique</li>
                </ul>
            </div>

            <small>&copy; {{ 'now'|date('Y') }} WorkTogether Data Solutions</small>
        </aside>

        <main class="login-panel">
            <div class="login-card">
                <h1>Connexion</h1>
                <p class="login-subtitle">Heureux de vous revoir. Connectez-vous à votre compte.</p>

                {% if error %}
                    <div class="login-alert" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="login-info">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
                        <a href="{{ path('app_logout') }}">Se déconnecter</a>
                    </div>
                {% endif %}

                <form method="post">
                    <div class="login-field">
                        <label for="username">Adresse e-mail</label>
                        <input type="email" id="username" name="_username"
                               value="{{ last_username }}"
                               autocomplete="email" placeholder="vous@entreprise.fr"
                               required autofocus>
                    </div>

                    <div class="login-field">
                        <label for="password">Mot de passe</label>
                        <div class="login-input-wrap">
                            <input type="password" id="password" name="_password"
                                   autocomplete="current-password" placeholder="Votre mot de passe"
                                   required>
                            <button type="button" class="login-toggle" id="togglePassword"
                                    aria-label="Afficher ou masquer le mot de passe">Afficher</button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="login-btn" type="submit">Se connecter</button>
                </form>

                <p class="login-links">
                    Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
                </p>
                <p class="login-links">
                    <a href="{{ path('app_home') }}">← Retour à l’accueil</a>
                </p>
            </div>
        </main>

    </div>

    <script>
        const champ = document.getElementById('password');
        const bouton = document.getElementById('togglePassword');
        bouton.addEventListener('click', () => {
            const visible = champ.type === 'text';
            champ.type = visible ? 'password' : 'text';
            bouton.textContent = visible ? 'Afficher' : 'Masquer';
        });
    </script>
{% endblock %}
