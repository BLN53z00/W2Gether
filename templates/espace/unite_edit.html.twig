{% extends 'base.html.twig' %}

{% block title %}Modifier l'unité{% endblock %}

{% block body %}
    {% set labels = {ok: 'Opérationnelle', incident: 'Incident', maintenance: 'Maintenance'} %}

    <div class="page-header">
        <h1>Modifier l’unité {{ unite.baie.numero }}-U{{ '%02d'|format(unite.numero) }}</h1>
        <p>
            État actuel :
            <span class="badge badge-{{ unite.etat.value }}">{{ labels[unite.etat.value] }}</span>
            · L’emplacement et l’état sont gérés par WorkTogether.
        </p>
    </div>

    <div class="card form-card">
        {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.type) }}
        {{ form_row(form.couleur) }}

        <div class="form-actions">
            <button type="submit" class="btn">Enregistrer</button>
            <a class="btn btn-outline" href="{{ path('espace_unites') }}">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
