{% extends 'base.html.twig' %}

{% block title %}Mes baies{% endblock %}

{% block body %}
    <h1>Mes baies</h1>
    <p><a href="{{ path('espace_accueil') }}">← Retour</a></p>

    {% for data in baies %}
        {% set baie = data.baie %}
        {% set unitesParNumero = data.unites %}

        <h2>Baie {{ baie.numero }}</h2>
        <div style="display:flex;flex-direction:column-reverse;width:260px;border:2px solid #333;">
            {% for n in 1..baie.nbUnites %}
                {% if unitesParNumero[n] is defined %}
                    {% set u = unitesParNumero[n] %}
                    <div style="height:16px;font-size:11px;border-bottom:1px solid #ddd;padding-left:4px;background:{{ u.couleur ?? '#cccccc' }};color:#000;">
                        U{{ '%02d'|format(n) }}
                        {% if u.nom %}– <a href="{{ path('espace_unite_edit', {id: u.id}) }}">{{ u.nom }}</a>{% endif %}
                    </div>
                {% else %}
                    <div style="height:16px;font-size:11px;border-bottom:1px solid #ddd;padding-left:4px;background:#f5f5f5;color:#aaa;">
                        U{{ '%02d'|format(n) }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% else %}
        <p>Vous n'avez aucune baie pour le moment.</p>
    {% endfor %}
{% endblock %}
