{% extends 'base.html.twig' %}

{% block title %}Mes baies{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Mes baies</h1>
        <p>Chaque baie compte 42 emplacements, numérotés de U01 (en bas) à U42 (en haut).</p>
    </div>

    {% if baies is empty %}
        <div class="card">
            <p>Vous n’avez aucune baie pour le moment.</p>
        </div>
    {% else %}
        <div class="racks">
            {% for data in baies %}
                {% set baie = data.baie %}
                {% set unitesParNumero = data.unites %}

                <div class="card">
                    <h2>Baie {{ baie.numero }}</h2>
                    <p class="rack-count">{{ unitesParNumero|length }} unité{{ unitesParNumero|length > 1 ? 's' : '' }} sur {{ baie.nbUnites }}</p>

                    <div class="rack">
                        {% for n in 1..baie.nbUnites %}
                            {% if unitesParNumero[n] is defined %}
                                {% set u = unitesParNumero[n] %}
                                <div class="rack-slot rack-slot-used" style="border-left-color: {{ u.couleur ?? '#3b82f6' }}">
                                    <span class="rack-num">U{{ '%02d'|format(n) }}</span>
                                    <a href="{{ path('espace_unite_edit', {id: u.id}) }}">{{ u.nom ?? 'Sans nom' }}</a>
                                </div>
                            {% else %}
                                <div class="rack-slot">
                                    <span class="rack-num">U{{ '%02d'|format(n) }}</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
