{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Bonjour {{ app.user.prenom }}</h1>
        <p>
            {% if app.user.entreprise %}{{ app.user.entreprise }} · {% endif %}
            Voici un résumé de votre espace client.
        </p>
    </div>

    <div class="card stats">
        <div class="stat">
            <div class="stat-value">{{ nbUnites }}</div>
            <div class="stat-label">Unités louées</div>
        </div>
        <div class="stat">
            <div class="stat-value">{{ nbBaies }}</div>
            <div class="stat-label">Baies utilisées</div>
        </div>
        <div class="stat">
            <div class="stat-value">{{ nbIncidents }}</div>
            <div class="stat-label">Incident ou maintenance</div>
        </div>
    </div>

    <div class="links">
        <div class="card">
            <h2>Mes unités</h2>
            <p>Consultez l’emplacement et l’état de vos unités, puis personnalisez leur nom, type et couleur.</p>
            <a class="btn" href="{{ path('espace_unites') }}">Gérer mes unités</a>
        </div>

        <div class="card">
            <h2>Mes baies</h2>
            <p>Visualisez vos équipements dans la baie, avec ses 42 emplacements.</p>
            <a class="btn btn-outline" href="{{ path('espace_baies') }}">Voir mes baies</a>
        </div>
    </div>
{% endblock %}
