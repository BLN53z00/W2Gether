{% extends 'base.html.twig' %}

{% block title %}Mes unités{% endblock %}

{% block body %}
    {% set labels = {ok: 'Opérationnelle', incident: 'Incident', maintenance: 'Maintenance'} %}

    <div class="page-header">
        <h1>Mes unités</h1>
        <p>
            {{ unites|length }} unité{{ unites|length > 1 ? 's' : '' }} louée{{ unites|length > 1 ? 's' : '' }}.
            Vous pouvez personnaliser le nom, le type et la couleur de chacune.
        </p>
    </div>

    <div class="card">
        {% if unites is empty %}
            <p>Vous n’avez aucune unité pour le moment.</p>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th>Emplacement</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>État</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for u in unites %}
                        <tr>
                            <td><strong>{{ u.baie.numero }}-U{{ '%02d'|format(u.numero) }}</strong></td>
                            <td>
                                <span class="color-dot" style="background: {{ u.couleur ?? '#cbd5e1' }}"></span>
                                {{ u.nom ?? '—' }}
                            </td>
                            <td>{{ u.type ?? '—' }}</td>
                            <td>
                                <span class="badge badge-{{ u.etat.value }}">{{ labels[u.etat.value] }}</span>
                            </td>
                            <td><a href="{{ path('espace_unite_edit', {id: u.id}) }}">Modifier</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
